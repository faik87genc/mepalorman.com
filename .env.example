# Admin paneli (/admin/) — ADMIN_PASSWORD_HASH ve SESSION_SECRET: npm run hash-password
DATABASE_URL=            # Neon Postgres (tablo kendiliğinden kurulur)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=   # Vercel Blob, PUBLIC store (görsel yükleme)

# Site
NEXT_PUBLIC_SITE_URL=https://mepalorman.com
NEXT_PUBLIC_GA4_ID=            # GA4 ölçüm kimliği (G-XXXX); çerez onayından sonra yüklenir

# Teklif formu e-postası (boşsa talepler sunucu günlüğüne yazılır)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cevatsenturk@mepalorman.com
LEAD_TO=cevatsenturk@mepalorman.com

# Yapay zekâ (Palet Danışmanı + fotoğraftan değerleme); boşsa kural tabanlı yedek cevap verilir
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
